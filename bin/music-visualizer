#!/bin/bash
# Music Visualizer: a hacker-terminal style audio visualizer in your Omarchy theme colors.
#
# Plays a track (YouTube/SoundCloud URL, local file, or YouTube search) on loop in
# an mpv window: scrolling spectrogram, live hex dump, frequency bars and waveform
# under a fake php2shell session header. Colors follow the current Omarchy theme
# and fade live when it changes. Typing in the window searches for a new song.
#
# Run `music-visualizer --help` for usage.

NAME="Music Visualizer"
TITLE="$NAME ::"
HERE=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Per-run files (mpv IPC socket, header/hex text) live in a fresh private directory,
# created atomically by mktemp (mode 0700, never reused), so no other account can
# precreate it or plant symlinks in it, even on the shared /tmp fallback.
RUNBASE="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/music-visualizer/config"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/music-visualizer"

usage() {
  local conf=${CONF/#$HOME/\~} cache=${CACHE/#$HOME/\~}
  cat <<EOF
$NAME: a hacker-terminal music visualizer in your Omarchy colors.

Usage:
  music-visualizer [SOURCE] [LABEL]        open the visualizer (playing SOURCE);
                                           with no SOURCE, close it if open
  music-visualizer start [SOURCE] [LABEL]  open, replacing a running visualizer
  music-visualizer load SOURCE [LABEL]     switch the open visualizer to SOURCE
  music-visualizer off                     close it
  music-visualizer status                  print "on" or "off"
  music-visualizer retheme                 fade it to the current theme's colors
  music-visualizer config                  open your settings file (created
                                           with every option explained)
  music-visualizer help                    show this help (also -h, --help)

SOURCE is a link (YouTube, SoundCloud, Bandcamp... anything yt-dlp plays), a
local audio file, search terms (plays the top YouTube result), or "shuffle".
Without one it plays the configured track, which is shuffle by default. LABEL
replaces the track title in the header.

Shuffle plays random tracks from a playlist, each once before any repeat, and
moves on when a track ends. The built-in playlist is "hacker-trance": classic
trance anthems plus hacker-film soundtrack cuts.

In the window:
  type anything   search: the text appears in the terminal prompt
    Enter         play the search (loops it; leaves shuffle)
    Esc           cancel it
    Backspace     delete a character       Ctrl+W    delete a word
    Ctrl+U        clear                    Ctrl+V    paste (links work too)
  Tab             shuffle: play a random track (again: skip to another)
  Right           next track (from a looped song: back to shuffle)
  Left            replay from the start; twice quickly: previous track
  Space           pause / resume (types a space while searching)
  Up/Down         volume
  F11             fullscreen (or double-click; Esc leaves it)
  Ctrl+Q          quit (or your toggle shortcut, or Super+W)
  Media keys      play/pause, and Next skips in shuffle (needs mpv-mpris,
                  part of Omarchy)

While a new song loads, the current one keeps playing. If nothing matches,
the header says so and the current song carries on.

Settings live in $conf.
Run "music-visualizer config" to open it. It's plain "name = value" lines,
each explained in the file:
  track    = shuffle (default) | search terms | a link | a file
             what plays when it opens
  label    = header text for that track (default: the track's real title)
  playlist = hacker-trance (default) | a YouTube/SoundCloud playlist link |
             a music folder | a text file with one song per line
             what shuffle plays
  palette  = theme (default) | green
Changes apply the next time it opens.

Songs are cached in $cache after the first play. The
least recently played are removed once the cache passes 1 GB.
EOF
}

conf() { # conf <key> -> its value in the config file (last one wins)
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null | tail -1 |
    sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}
running() { pgrep -f -- "--title=$TITLE" >/dev/null; }

instances() { # live visualizers, "<pid> <run dir>" per line; stale run dirs are removed
  local d pid
  for d in "$RUNBASE"/music-visualizer.*; do
    # ours only: a real directory we own (anything else in a shared /tmp is ignored)
    [[ -d $d && ! -L $d && -O $d ]] || continue
    pid=${d##*/music-visualizer.}; pid=${pid%%.*}
    [[ $pid =~ ^[0-9]+$ ]] || continue
    # only a live visualizer counts (a stale dir's PID may belong to something else now)
    if tr '\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q 'music-visualizer'; then
      printf '%s %s\n' "$pid" "$d"
    else
      rm -rf -- "$d"
    fi
  done
}

case "$1" in
  help | -h | --help) usage; exit 0 ;;
  status) running && echo on || { echo off; exit 1; }; exit ;;
  off) pkill -f -- "--title=$TITLE"; exit 0 ;;
  retheme)
    instances | while read -r pid _; do kill -USR1 "$pid"; done
    exit 0 ;;
  load)
    # hand a new track to the running visualizer, which switches in place (USR2)
    shift
    [[ -n $1 ]] || { echo "usage: music-visualizer load SOURCE [LABEL]" >&2; exit 2; }
    found="" cmd=load
    [[ $1 == shuffle ]] && cmd=shuffle
    while read -r pid d; do
      printf '%s\n%s\n%s\n' "$cmd" "${1//$'\n'/ }" "${2//$'\n'/ }" >"$d/request.tmp" &&
        mv -f "$d/request.tmp" "$d/request" && kill -USR2 "$pid" && found=1
    done < <(instances)
    [[ -n $found ]] || { echo "$NAME isn't running (start it with: music-visualizer start SOURCE)" >&2; exit 1; }
    exit 0 ;;
  config)
    # create the settings file from the commented template, then open it
    if [[ ! -e $CONF ]]; then
      mkdir -p "$(dirname "$CONF")" && cp "$HERE/config.example" "$CONF" &&
        echo "Created $CONF"
    fi
    if [[ -t 1 && -n $EDITOR ]]; then
      $EDITOR "$CONF" # may carry flags, e.g. "omarchy-launch-editor --inline"
    elif command -v omarchy >/dev/null; then
      omarchy launch config editor "$CONF"
    else
      echo "Edit $CONF"
    fi
    exit 0 ;;
  start)
    # explicit start (used by the Omarchy plugin): replace any running visualizer
    shift
    if running; then
      pkill -f -- "--title=$TITLE"
      for _ in $(seq 1 20); do running || break; sleep 0.1; done
    fi
    START=1 ;;
  -*) echo "unknown option: $1 (see music-visualizer --help)" >&2; exit 2 ;;
esac
if [[ -z $START && -z $1 ]] && running; then pkill -f -- "--title=$TITLE"; exit 0; fi

# Launched from the Omarchy shell (or a keybind), stdout is a pipe nobody reads, and
# mpv's constant status output would fill it and freeze playback. Keep output only
# for interactive terminal use.
[[ -t 1 ]] || exec >/dev/null 2>&1 </dev/null

RUN=$(mktemp -d "$RUNBASE/music-visualizer.$$.XXXXXXXX") || exit 1
trap 'kill $HEXPID $TITLEPID $MPVPID 2>/dev/null; stop_load; rm -rf "$RUN"' EXIT
# make TERM/INT/HUP (e.g. the Omarchy shell stopping the plugin) run the EXIT cleanup too
trap 'exit 143' TERM INT HUP

FONT="JetBrainsMono Nerd Font"
HOST=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null)
ipc() { socat - "UNIX-CONNECT:$RUN/mpv.sock" 2>/dev/null; }
ipc_get() { # ipc_get <property> -> its value, empty if unavailable
  jq -nc --arg p "$1" '{command: ["get_property", $p]}' | ipc |
    jq -r 'select(.error == "success") | .data // empty' 2>/dev/null | head -1
}
atomic() { # atomic <file>: write stdin to a file that drawtext may be reading
  cat >"$1.tmp" && mv -f "$1.tmp" "$1"
}

# --- what to play -----------------------------------------------------------------
# resolve <src> [label]: sets SHOWN (what was asked for), SRC (what mpv plays), LABEL,
# and KEY (cache key) for a remote source. A cached copy replaces a remote SRC.
#
# Audio cache: resolving a YouTube URL costs 2+ s on every launch (more when YouTube
# rotates its player JS), so the first play streams while a background yt-dlp saves
# the audio and its title (cache_bg); later plays of the same URL/search start
# instantly. cache_trim keeps it under 1 GB. Clear with: rm -rf ~/.cache/music-visualizer
resolve() {
  SRC=$1 LABEL=$2 KEY=""
  [[ $SRC == "~/"* ]] && SRC="$HOME/${SRC#\~/}"
  SHOWN=$SRC
  [[ $SRC == *://* || -e $SRC ]] || SRC="ytdl://ytsearch1:$SRC"
  [[ -e $SRC ]] && return
  KEY=$(printf '%s' "$SRC" | sha1sum | cut -c1-16)
  local cached
  cached=$(find "$CACHE" -maxdepth 1 -name "$KEY.*" ! -name '*.part' ! -name '*.ytdl' \
    ! -name '*.title' -size +0 2>/dev/null | head -1)
  if [[ -n $cached ]]; then
    SRC=$cached
    touch -c -- "$cached" # recently played: kept longest by cache_trim
    [[ -z $LABEL && -s $CACHE/$KEY.title ]] && LABEL=$(head -1 "$CACHE/$KEY.title")
  fi
}
cache_bg() { # save the remote $SRC (cache key $KEY) in the background
  pgrep -f -- "music-visualizer-cache/$KEY" >/dev/null && return
  mkdir -p "$CACHE"
  setsid -f yt-dlp -q --no-warnings --no-playlist -f bestaudio/best --no-simulate \
    --print-to-file title "$CACHE/$KEY.title" -o "$CACHE/$KEY.%(ext)s" \
    --exec "true music-visualizer-cache/$KEY" -- "${SRC#ytdl://}" >/dev/null 2>&1
}
cache_trim() { # keep the song cache under 1 GB, removing the least recently played
  local limit=$((1024 * 1024 * 1024)) total=0 size path
  find "$CACHE" -maxdepth 1 -type f ! -name '*.title' ! -name 'playlist-*' \
    ! -name '*.part' ! -name '*.ytdl' -printf '%T@ %s %p\n' 2>/dev/null | sort -rn |
    while read -r _ size path; do
      total=$((total + size))
      ((total > limit)) && rm -f -- "$path" "${path%.*}.title"
    done
}
# fallback title for a source without one: search terms as typed, or a file's name
plain_title() {
  if [[ -e $SHOWN ]]; then
    local b
    b=$(basename "$SHOWN")
    printf '%s' "${b%.*}"
  else
    printf '%s' "$SHOWN"
  fi
}

# lookup <src> [label]: find something mpv can play right away -> SRC, LTITLE.
# A remote source is resolved to its direct stream with yt-dlp (~2 s), which
# meanwhile starts caching it. Fails if nothing playable was found.
lookup() {
  local out url
  resolve "$1" "$2"
  LTITLE=$LABEL
  if [[ ! -e $SRC ]]; then
    out=$(yt-dlp -q --no-warnings --no-playlist -f bestaudio/best \
      --print title --print urls -- "${SRC#ytdl://}" 2>/dev/null)
    url=$(sed -n 2p <<<"$out")
    [[ $url == http* ]] || return 1
    LTITLE=${LTITLE:-$(sed -n 1p <<<"$out")}
    cache_bg
    SRC=$url
  fi
  [[ -n $LTITLE ]] || LTITLE=$(plain_title)
}

# --- track history (Left Left = previous track, Right = next) ----------------------
# $RUN/history lists the tracks played, one "<source>\t<title>\t<shuffle n/total>"
# per line (the source is looked up again on replay; the cache makes that quick),
# and $RUN/histpos is the line playing now. Like a browser's back/forward: going
# back and then playing something new drops what was ahead.
tabless() { printf '%s' "${1//$'\t'/ }"; }
hist_pos() { cat "$RUN/histpos" 2>/dev/null || echo 0; }
hist_count() { wc -l <"$RUN/history" 2>/dev/null || echo 0; }
hist_push() { # hist_push <source> <title> [n/total]: a new track is playing
  [[ -n $1 ]] || return
  { head -n "$(hist_pos)" "$RUN/history" 2>/dev/null
    printf '%s\t%s\t%s\n' "$(tabless "$1")" "$(tabless "$2")" "$3"
  } | tail -n 200 >"$RUN/history.tmp" && mv -f "$RUN/history.tmp" "$RUN/history"
  hist_count >"$RUN/histpos"
}
hist_read() { # hist_read <line> -> HSRC, HTITLE, HPOS
  IFS=$'\t' read -r HSRC HTITLE HPOS < <(sed -n "${1}p" "$RUN/history" 2>/dev/null)
  [[ -n $HSRC ]]
}
hist_queue() { # hist_queue <loadfile flags>: hand mpv the history entry after this one
  local n=$(($(hist_pos) + 1))
  ((n <= $(hist_count))) && hist_read "$n" && lookup "$HSRC" "$HTITLE" || return 1
  jq -nc --arg u "$SRC" --arg f "$1" --arg t "$LTITLE" \
    '{command: {name: "loadfile", url: $u, flags: $f, options: {"force-media-title": $t}}}' |
    ipc >/dev/null
  QPOS=$HPOS QTITLE=$LTITLE QSRC=$HSRC
}

# --- shuffle ------------------------------------------------------------------------
# Shuffle plays random tracks from a playlist, each once before any repeats (a
# shuffled "bag" in $RUN/bag). While one track plays, the next is looked up and
# queued in mpv's playlist, so tracks change without a gap, and Tab or the Next media
# key (MPRIS playlist-next) skips. $RUN/shuffle flags shuffle mode for search.lua,
# which reports each move to the queued track ("advance").

playlist_file() { # entries of a playlist text file: skips blank lines and # comments
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$1" 2>/dev/null
}
playlist_entries() { # the configured playlist, one source per line
  local p list out
  p=$(conf playlist)
  p=${p:-hacker-trance}
  [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  [[ $p != */* && -f $HERE/playlists/$p.txt ]] && p="$HERE/playlists/$p.txt"
  if [[ -d $p ]]; then # a music folder
    out=$(find -L "$p" -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' \
      -o -iname '*.opus' -o -iname '*.m4a' -o -iname '*.wav' -o -iname '*.aac' \
      -o -iname '*.webm' \) 2>/dev/null)
  elif [[ -f $p ]]; then # a text file: searches, links or files, one per line
    out=$(playlist_file "$p")
  elif [[ $p == *://* ]]; then # an online playlist, listed once a day
    list="$CACHE/playlist-$(printf '%s' "$p" | sha1sum | cut -c1-16).txt"
    if [[ ! -s $list || -n $(find "$list" -mmin +1440 2>/dev/null) ]]; then
      mkdir -p "$CACHE"
      yt-dlp -q --no-warnings --flat-playlist --print url -- "$p" >"$list.tmp" 2>/dev/null &&
        [[ -s $list.tmp ]] && mv -f "$list.tmp" "$list"
      rm -f "$list.tmp"
    fi
    out=$(cat "$list" 2>/dev/null)
  fi
  # a playlist that's missing or empty falls back to the built-in one
  [[ -n $out ]] || out=$(playlist_file "$HERE/playlists/hacker-trance.txt")
  printf '%s\n' "$out"
}

shuffle_pick() { # -> "<n>/<total><TAB><source>": the next track from the bag
  local bag=$RUN/bag entry n
  if [[ ! -s $bag ]]; then
    playlist_entries | shuf >"$bag.new"
    [[ -s $bag.new ]] || { rm -f "$bag.new"; return 1; }
    # don't start a new round with the track that just played
    if [[ $(head -1 "$bag.new") == "$(cat "$RUN/lastpick" 2>/dev/null)" && $(wc -l <"$bag.new") -gt 1 ]]; then
      { tail -n +2 "$bag.new"; head -1 "$bag.new"; } >"$bag.tmp" && mv -f "$bag.tmp" "$bag.new"
    fi
    mv -f "$bag.new" "$bag"
    wc -l <"$bag" >"$RUN/bagsize"
    echo 0 >"$RUN/bagn"
  fi
  entry=$(head -1 "$bag")
  tail -n +2 "$bag" >"$bag.tmp" && mv -f "$bag.tmp" "$bag"
  n=$(($(cat "$RUN/bagn") + 1))
  echo "$n" >"$RUN/bagn"
  printf '%s\n' "$entry" >"$RUN/lastpick"
  printf '%s/%s\t%s\n' "$n" "$(cat "$RUN/bagsize")" "$entry"
}

unqueue() { # a queued random pick that won't play next goes back on top of the bag
  local pos title kind src
  [[ -s $RUN/upnext ]] && IFS=$'\t' read -r pos title kind src <"$RUN/upnext"
  [[ $kind == new && -n $src ]] || return
  { printf '%s\n' "$src"; cat "$RUN/bag" 2>/dev/null; } >"$RUN/bag.tmp" && mv -f "$RUN/bag.tmp" "$RUN/bag"
  echo $(($(cat "$RUN/bagn") - 1)) >"$RUN/bagn"
}

shuffle_status() { # shuffle_status <n/total> <next title> -> the header's status line
  local next=$2
  ((${#next} > 44)) && next="${next:0:43}…"
  printf '[#] STAGE  SHUFFLE :: track %s :: next: %s' "${1:-replay}" "$next"
}

queue_pick() { # queue_pick <loadfile flags>: look up a random track and hand it to mpv
  local pick _
  for _ in 1 2 3; do # skip picks that can't be found
    pick=$(shuffle_pick) || return 1
    lookup "${pick#*$'\t'}" || continue
    jq -nc --arg u "$SRC" --arg f "$1" --arg t "$LTITLE" \
      '{command: {name: "loadfile", url: $u, flags: $f, options: {"force-media-title": $t}}}' |
      ipc >/dev/null
    QPOS=${pick%%$'\t'*} QTITLE=$LTITLE QSRC=${pick#*$'\t'}
    return 0
  done
  return 1
}

queue_upcoming() { # queue the track after the current one, and show it in the header
  local title now kind=new
  title=$(head -1 "$RUN/label" 2>/dev/null)
  now=$(cat "$RUN/now" 2>/dev/null)
  # after going back (Left Left), what comes next is the track you came back from
  if hist_queue append-play; then kind=hist; fi
  if [[ $kind == hist ]] || queue_pick append-play; then
    printf '%s\t%s\t%s\t%s\n' "$QPOS" "$(tabless "$QTITLE")" "$kind" "$QSRC" >"$RUN/upnext"
    write_labels "$title" "$(shuffle_status "$now" "$QTITLE")"
  else
    rm -f "$RUN/upnext"
    write_labels "$title" "$(shuffle_status "$now" "(lookup failed: Tab to retry)")"
  fi
}

shuffle_start() { # enter shuffle (or reshuffle): a random track now, the next queued
  local old
  old=$(head -1 "$RUN/label" 2>/dev/null)
  write_labels "$old" "[~] SHUFFLE picking a track"
  : >"$RUN/shuffle"
  rm -f "$RUN/upnext" "$RUN/loadfail"
  printf '%s\n' '{"command":["set_property","loop-file","no"]}' | ipc >/dev/null
  if ! queue_pick replace; then
    rm -f "$RUN/shuffle"
    printf '%s\n' '{"command":["set_property","loop-file","inf"]}' | ipc >/dev/null
    write_labels "$old" "[!] ERROR  shuffle: nothing in the playlist could be found"
    return
  fi
  hist_push "$QSRC" "$QTITLE" "$QPOS"
  printf '%s\n' "$QPOS" >"$RUN/now"
  write_labels "$QTITLE" "$(shuffle_status "$QPOS" "resolving…")"
  set_title "$QTITLE"
  queue_upcoming
}

shuffle_advance() { # mpv moved on to the queued track (song ended, Tab or Next key)
  [[ -e $RUN/shuffle && -s $RUN/upnext ]] || return
  local pos title kind src
  IFS=$'\t' read -r pos title kind src <"$RUN/upnext"
  rm -f "$RUN/upnext"
  if [[ $kind == hist ]]; then
    echo $(($(hist_pos) + 1)) >"$RUN/histpos"
  else
    hist_push "$src" "$title" "$pos"
  fi
  printf '%s\n' '{"command":["playlist-clear"]}' | ipc >/dev/null # drop played tracks
  printf '%s\n' "$pos" >"$RUN/now"
  write_labels "$title" "$(shuffle_status "$pos" "resolving…")"
  set_title "$title"
  queue_upcoming
}

# --- the first track ----------------------------------------------------------------
if [[ -n $1 ]]; then
  first=$1 first_label=$2
elif [[ -n $(conf track) ]]; then
  first=$(conf track) first_label=$(conf label)
else
  first=shuffle first_label=""
fi
SHUFFLE="" NOWPOS="" NEED_TITLE=""
if [[ $first == shuffle ]] && pick=$(shuffle_pick); then
  SHUFFLE=1 NOWPOS=${pick%%$'\t'*}
  resolve "${pick#*$'\t'}" ""
  if [[ -z $LABEL ]]; then
    LABEL=$(plain_title)
    [[ $SHOWN == *://* ]] && NEED_TITLE=1 # a bare link: use mpv's title once known
  fi
else
  [[ $first == shuffle ]] && first="https://www.youtube.com/watch?v=T6hOlik58gg"
  resolve "$first" "$first_label"
  # No label yet: show what was asked for, then swap in mpv's media title once known.
  if [[ -z $LABEL ]]; then
    LABEL=$SHOWN
    [[ -e $SHOWN ]] && LABEL=$(basename "$SHOWN")
    NEED_TITLE=1
  fi
fi
# the first track starts the history (a title still to be learned is looked up on replay)
if [[ -n $NEED_TITLE ]]; then hist_push "$SHOWN" "" "$NOWPOS"; else hist_push "$SHOWN" "$LABEL" "$NOWPOS"; fi
[[ -n $KEY && ! -e $SRC ]] && cache_bg
(cache_trim) &

# --- colors -----------------------------------------------------------------------
# The graph below draws a color-neutral *mask*: red channel = accent layers (prompt,
# clock, spectrogram, bars, waveform, borders, grid), green = foreground layers
# (status lines, hex dump, footer), blue = alert (SIGNAL LOCKED), black = background.
# One colorchannelmixer (@theme, in mpv's --vf chain) maps the mask onto the theme:
#   out = BG + R*(ACCENT-BG) + G*(FG-BG) + B*(ALERT-BG)
# A theme change only sends new coefficients to that filter, stepped over ~0.8 s,
# so colors fade smoothly and playback/audio are never touched.

theme_colors() { # -> 12 ints: bg, accent, fg, alert (r g b each)
  local f="$HOME/.local/state/omarchy/current/theme/colors.toml"
  [[ $(conf palette) == green ]] && f=/dev/null
  local key fb v out=()
  for key in background:020702 accent:00ff41 foreground:00ff41 red:ff2bd6; do
    fb=${key#*:}; key=${key%%:*}
    v=$(sed -n "s/^$key[[:space:]]*=[[:space:]]*\"#\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$f" 2>/dev/null | head -1)
    v=${v:-$fb}
    out+=($((16#${v:0:2})) $((16#${v:2:2})) $((16#${v:4:2})))
  done
  echo "${out[*]}"
}

# colorchannelmixer options for 12 color values (bg, accent, fg, alert)
mixer() {
  awk -v c="$*" 'BEGIN {
    split(c, v, " "); split("r g b", ch, " ")
    for (i = 1; i <= 3; i++) {
      bg = v[i]; k[ch[i] "r"] = (v[3+i]-bg)/255; k[ch[i] "g"] = (v[6+i]-bg)/255
      k[ch[i] "b"] = (v[9+i]-bg)/255; k[ch[i] "a"] = bg/255
    }
    n = split("rr rg rb ra gr gg gb ga br bg bb ba", names, " ")
    for (j = 1; j <= n; j++) s = s (j > 1 ? ":" : "") names[j] "=" sprintf("%.5f", k[names[j]])
    print s
  }'
}

CUR=($(theme_colors))
bghex() { printf '#%02x%02x%02x' "$1" "$2" "$3"; }
# accent + background as RRGGBB, for search.lua's pause overlay (mpv's OSD is drawn
# after the theme mixer, so it needs the real colors)
osd_colors() { printf '%02x%02x%02x %02x%02x%02x\n' "${CUR[@]:3:3}" "${CUR[@]:0:3}" | atomic "$RUN/colors"; }
osd_colors

# fade the running mpv from CUR to the theme's current colors (~0.8 s, smoothstep)
retheme() {
  local NEW=($(theme_colors))
  [[ ${NEW[*]} == "${CUR[*]}" ]] && return
  awk -v from="${CUR[*]}" -v to="${NEW[*]}" -v steps=24 'BEGIN {
    split(from, a, " "); split(to, b, " "); split("r g b", ch, " ")
    n = split("rr rg rb ra gr gg gb ga br bg bb ba", names, " ")
    for (s = 1; s <= steps; s++) {
      x = s / steps; e = x * x * (3 - 2 * x)
      for (j = 1; j <= 12; j++) v[j] = a[j] + (b[j] - a[j]) * e
      for (i = 1; i <= 3; i++) {
        bg = v[i]; k[ch[i] "r"] = (v[3+i]-bg)/255; k[ch[i] "g"] = (v[6+i]-bg)/255
        k[ch[i] "b"] = (v[9+i]-bg)/255; k[ch[i] "a"] = bg/255
      }
      for (j = 1; j <= n; j++)
        printf "{\"command\":[\"vf-command\",\"theme\",\"%s\",\"%.5f\"]}\n", names[j], k[names[j]]
      printf "{\"command\":[\"set_property\",\"background-color\",\"#%02x%02x%02x\"]}\n", v[1], v[2], v[3]
      fflush(); system("sleep 0.033")
    }
  }' | ipc >/dev/null
  CUR=("${NEW[@]}")
  # vf-command only changes the running filter. mpv rebuilds the --vf chain from the
  # `vf` property on every new track, so store the new colors there too, or the
  # next song would bring back the colors it opened with.
  jq -nc --arg vf "@theme:colorchannelmixer=$(mixer "${CUR[@]}")" \
    '{command: ["set_property", "vf", $vf]}' | ipc >/dev/null
  osd_colors
}

# --- header text (re-read by drawtext every frame, so it can change mid-play) -----
# The prompt line doubles as the search box: while you type, lua/search.lua owns
# prompt.txt (and footer.txt) and flags it with $RUN/typing. This script then only
# updates prompt.idle, which search.lua puts back when typing ends.
write_labels() { # write_labels <label> [status line]
  printf '%s\n' "$1" >"$RUN/label"
  printf '%s\n' "root@$HOST:~# ./php2shell --profile 21 --stream audio://$(printf '%s' "$1" | tr ' ' '_' | tr -cd '[:alnum:]_().-' | cut -c1-48)" |
    atomic "$RUN/prompt.idle"
  [[ -e $RUN/typing ]] || atomic "$RUN/prompt.txt" <"$RUN/prompt.idle"
  printf '%s\n' \
    "[*] START  operation initialized" \
    "[>] INFO   payload :: $1" \
    "${2:-[#] STAGE  CHAIN ACTIVE :: spectral exfiltration :: loop=inf}" | atomic "$RUN/header.txt"
}
if [[ -n $SHUFFLE ]]; then
  : >"$RUN/shuffle"
  printf '%s\n' "$NOWPOS" >"$RUN/now"
  write_labels "$LABEL" "$(shuffle_status "$NOWPOS" "resolving…")"
else
  write_labels "$LABEL"
fi
printf '%s\n' "RCE R1TU4L ST4RT3D -> 0P3N1NG P0RT4L      :: type to search :: [TAB] shuffle" |
  atomic "$RUN/footer.idle"
atomic "$RUN/footer.txt" <"$RUN/footer.idle"

set_title() { # window title, plus the track title mpv reports over MPRIS (media widgets)
  jq -nc --arg t "$TITLE $1" --arg m "$1" \
    '{command: ["set_property", "title", $t]}, {command: ["set_property", "force-media-title", $m]}' |
    ipc >/dev/null
}

# once mpv knows the track's real title, use it for the header and window title
title_watch() {
  local t _
  # until playback starts, media-title is only a placeholder (e.g. "watch?v=...")
  for _ in $(seq 1 120); do
    sleep 0.25
    [[ -n $(ipc_get playback-time) ]] && break
  done
  t=$(ipc_get media-title)
  [[ -n $t && $t != "$SHOWN" && $t != ytsearch* && $t != *://* ]] || return
  write_labels "$t" "$(sed -n 3p "$RUN/header.txt")" # keep the status line
  set_title "$t"
}

# --- switching tracks in place (search box, or `music-visualizer load`) ------------
# load_track <src> [label]: resolve the new source while the current song keeps
# playing, then swap mpv over to it (looping, which also leaves shuffle). search.lua
# falls back to the previous track if mpv can't play the new one, and flags that
# with $RUN/loadfail.
load_track() {
  local q=$1 old title _
  old=$(head -1 "$RUN/label" 2>/dev/null)
  write_labels "$old" "[~] SEARCH resolving :: $q"
  if ! lookup "$q" "$2"; then
    write_labels "$old" "[!] ERROR  no match :: $q"
    return
  fi
  title=$LTITLE
  unqueue
  rm -f "$RUN/shuffle"
  play_now inf || { write_labels "$old" "[!] ERROR  $PLAYERR :: $q"; return; }
  hist_push "$q" "$title" ""
  write_labels "$title"
  set_title "$title"
}

# play_now <loop-file>: switch mpv to the looked-up $SRC/$LTITLE right away and wait
# until it plays. Fails (with PLAYERR) if mpv couldn't play it: search.lua has then
# gone back to the previous track.
play_now() {
  local _
  rm -f "$RUN/loadfail" "$RUN/upnext"
  jq -nc --arg u "$SRC" --arg l "$1" --arg t "$LTITLE" '{command: ["set_property", "loop-file", $l]},
    {command: ["set_property", "pause", false]},
    {command: {name: "loadfile", url: $u, flags: "replace", options: {"force-media-title": $t}}}' |
    ipc >/dev/null
  for _ in $(seq 1 80); do
    sleep 0.25
    [[ -e $RUN/loadfail ]] && { PLAYERR="couldn't play"; return 1; }
    [[ $(ipc_get path) == "$SRC" && -n $(ipc_get playback-time) ]] && return 0
  done
  PLAYERR="timed out"
  return 1
}

# hist_go <-1|1>: play the previous or next track in the history, staying in shuffle
# or loop mode. Right past the end of the history moves on in shuffle (or starts it).
hist_go() {
  local n=$(($(hist_pos) + $1)) old what=previous loop=inf
  ((n >= 1)) || return
  if ((n > $(hist_count))); then shuffle_start; return; fi
  hist_read "$n" || return
  (($1 > 0)) && what=next
  [[ -e $RUN/shuffle ]] && loop=no
  old=$(head -1 "$RUN/label" 2>/dev/null)
  write_labels "$old" "[~] SEEK   $what track :: ${HTITLE:-$HSRC}"
  if ! lookup "$HSRC" "$HTITLE"; then
    write_labels "$old" "[!] ERROR  no match :: ${HTITLE:-$HSRC}"
    return
  fi
  [[ $loop == no ]] && unqueue
  play_now "$loop" || { write_labels "$old" "[!] ERROR  $PLAYERR :: $LTITLE"; return; }
  echo "$n" >"$RUN/histpos"
  set_title "$LTITLE"
  if [[ $loop == no ]]; then
    printf '%s\n' "$HPOS" >"$RUN/now"
    write_labels "$LTITLE" "$(shuffle_status "$HPOS" "resolving…")"
    queue_upcoming
  else
    write_labels "$LTITLE"
  fi
}

stop_load() { # cancel an in-progress track switch (and its yt-dlp lookup)
  [[ -n $LOADPID ]] || return
  pkill -P "$LOADPID" 2>/dev/null
  kill "$LOADPID" 2>/dev/null
  LOADPID=""
}

# USR2: a request in $RUN/request, three lines: <command> <source> <label>, from
# `music-visualizer load` or search.lua. Commands:
#   load     play <source> (typed search, summon, play)
#   shuffle  start shuffle, or skip to a new random track (Tab)
#   advance  mpv moved on to the queued shuffle track
#   prev     play the previous track (Left Left)
#   next     play the next track (Right, when mpv has none queued)
on_load() {
  local req=() cmd
  [[ -s $RUN/request ]] && mapfile -t req <"$RUN/request"
  rm -f "$RUN/request"
  cmd=${req[0]}
  case $cmd in
    load) [[ -n ${req[1]} ]] || return ;;
    shuffle | advance | prev | next) ;;
    *) return ;;
  esac
  # a song you picked wins over shuffle moving on in the meantime
  if [[ $cmd == advance && $LOADKIND =~ ^(load|prev|next)$ ]] && kill -0 "$LOADPID" 2>/dev/null; then return; fi
  [[ -n $TITLEPID ]] && kill "$TITLEPID" 2>/dev/null
  TITLEPID=""
  stop_load
  case $cmd in
    load) load_track "${req[1]}" "${req[2]}" & ;;
    shuffle) shuffle_start & ;;
    advance) shuffle_advance & ;;
    prev) hist_go -1 & ;;
    next) hist_go 1 & ;;
  esac
  LOADPID=$! LOADKIND=$cmd
}

# --- mask graph (colors are applied afterwards by @theme) --------------------------
# Every layer is generated from the audio, with no free-running sources: the
# frequency-bar stream, padded to full size, *is* the canvas. With --loop-file each
# loop seeks the audio back to 0. A free-running source (e.g. `color`) would keep
# counting up, and the overlays would buffer its frames without bound (~360 MB/s).
A=0xff0000 F=0x00ff00 L=0x0000ff
GRAPH="[aid1]asplit=4[ao][a1][a2][a3];
[a1]showspectrum=s=1380x420:slide=scroll:mode=combined:color=green:scale=log:fscale=log:legend=0:gain=1.6:fps=30,format=rgba,colorchannelmixer=rr=0:rg=1:gr=0:gg=0:br=0:bg=0:bb=0[spec];
[a2]aformat=channel_layouts=mono,showfreqs=s=1920x290:rate=30:mode=bar:ascale=log:fscale=log:colors=${A}:win_size=2048:averaging=3,format=rgb24,pad=1920:1080:0:590:color=black,format=rgba[base];
[a3]aformat=channel_layouts=mono,showwaves=s=1920x170:mode=cline:colors=${A}:draw=full:rate=30,format=rgba[wave];
[base][spec]overlay=20:150[t1];
[t1][wave]overlay=0:895,
drawbox=x=18:y=148:w=1384:h=424:color=${A}@0.5:t=2,
drawbox=x=1418:y=148:w=484:h=424:color=${A}@0.5:t=2,
drawgrid=w=60:h=30:t=1:c=${A}@0.05,
drawtext=font='${FONT}':textfile='$RUN/prompt.txt':reload=1:expansion=none:x=22:y=14:fontsize=21:fontcolor=${A},
drawtext=font='${FONT}':textfile='$RUN/header.txt':reload=1:expansion=none:x=22:y=44:fontsize=21:line_spacing=6:fontcolor=${F},
drawtext=font='${FONT}':textfile='$RUN/hex.txt':reload=1:expansion=none:x=1428:y=162:fontsize=14:line_spacing=7:fontcolor=${F}@0.75,
drawtext=font='${FONT}':text='T+%{pts\:hms}':x=w-tw-24:y=14:fontsize=26:fontcolor=${A},
drawtext=font='${FONT}':text='[ SIGNAL LOCKED ]':x=w-tw-24:y=52:fontsize=20:fontcolor=${L}:enable='lt(mod(t\,1)\,0.6)',
drawtext=font='${FONT}':textfile='$RUN/footer.txt':reload=1:expansion=none:x=22:y=1072-th:fontsize=18:fontcolor=${F}@0.6[vo]"

# live-updating hex dump column (first page written up front so mpv can start at once)
addr=$((0x7ffd3a2c0000))
hexpage() {
  for _ in $(seq 1 18); do
    printf '0x%012x  ' "$addr"
    head -c 8 /dev/urandom | od -An -tx1 | tr -s ' ' | sed 's/^ //' | tr '\n' ' '
    printf ' |%-8s|\n' "$(head -c 32 /dev/urandom | tr -dc 'A-Za-z0-9#$&*+<>?.' | head -c 8)"
    addr=$((addr + 8))
  done >"$RUN/hex.txt.tmp" && mv -f "$RUN/hex.txt.tmp" "$RUN/hex.txt" # not piped: addr must persist
}
hexpage
# Ends by itself if this script dies without cleanup (e.g. SIGKILL when the shell
# restarts), so it can never be left behind looping. ($$ is this script's PID.)
( while kill -0 $$ 2>/dev/null; do sleep 0.12; hexpage; done ) &
HEXPID=$!

trap retheme USR1
trap on_load USR2
# Safety net: run mpv in its own memory-capped scope (normal use is ~400 MB), so a
# runaway filter graph can only kill the visualizer, never the whole desktop.
MEMCAP=()
systemd-run --user --scope -q true >/dev/null 2>&1 &&
  MEMCAP=(systemd-run --user --scope -q -p MemoryMax=1500M -p MemorySwapMax=0 --)
EXTRA=()
# a single track loops; shuffle moves on to the next one when a track ends
LOOP=inf
[[ -n $SHUFFLE ]] && LOOP=no
# MPRIS (Omarchy ships mpv-mpris): media keys and the shell's media widgets see the
# visualizer. --no-config skips system scripts, so load it explicitly when present.
for so in /usr/lib/mpv-mpris/mpris.so /etc/mpv/scripts/mpris.so; do
  [[ -r $so ]] && { EXTRA+=(--script="$so"); break; }
done
# a known title (label or cache) is what MPRIS shows instead of the URL/cache file
# name; otherwise title_watch picks up mpv's own media title once it's known
[[ -z $NEED_TITLE ]] && EXTRA+=(--force-media-title="$LABEL")
# --no-config: the user's own mpv.conf/scripts (shaders, OSD overlays, fullscreen,
# resume...) must not change how the visualizer looks or behaves. mpv's own default
# keys and helper scripts are off too: search.lua defines every key (typing any
# letter searches) and keeps mpv idle-safe when a new track fails to load.
MVIZ_RUN=$RUN MVIZ_PID=$$ MVIZ_HOST=$HOST \
"${MEMCAP[@]}" mpv --no-config --msg-level=all=info --loop-file="$LOOP" --prefetch-playlist=yes \
  --ytdl-format=bestaudio/best --force-window=immediate --idle=yes \
  --title="$TITLE $LABEL" --keep-open=no --osc=no \
  --no-input-default-bindings --load-console=no --load-commands=no --load-select=no \
  --load-context-menu=no --load-positioning=no --load-stats-overlay=no \
  --script="$HERE/lua/search.lua" "${EXTRA[@]}" \
  --background=color --background-color="$(bghex "${CUR[@]:0:3}")" \
  --gpu-api=opengl --no-resume-playback --save-position-on-quit=no --autocreate-playlist=no \
  --input-ipc-server="$RUN/mpv.sock" \
  --lavfi-complex="$GRAPH" --vf="@theme:colorchannelmixer=$(mixer "${CUR[@]}")" "$SRC" &
MPVPID=$!
TITLEPID=""
if [[ -n $NEED_TITLE ]]; then title_watch & TITLEPID=$!; fi
LOADPID="" LOADKIND=""
if [[ -n $SHUFFLE ]]; then # queue the second track once the first is playing
  (
    for _ in $(seq 1 120); do
      sleep 0.25
      [[ -n $(ipc_get playback-time) ]] && break
    done
    queue_upcoming
  ) &
  LOADPID=$! LOADKIND=shuffle
fi

# mpv runs in the background so signals (theme change, new track) can be handled
# while it plays; `wait` returns early on a signal, so loop until mpv exits.
rc=0
while kill -0 "$MPVPID" 2>/dev/null; do wait "$MPVPID"; rc=$?; done

# mpv exits with 2 when it couldn't play the file/URL/search at all
if [[ $rc == 2 ]]; then
  summary="$NAME couldn't play that"
  body="$SHOWN"$'\n'"Check the link or search terms, and your connection."
  if command -v notify-send >/dev/null; then
    notify-send -a "$NAME" -i audio-x-generic "$summary" "$body" 2>/dev/null
  else # same notification straight over D-Bus (glib's gdbus is always present)
    gdbus call --session --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.Notify \
      "$NAME" 0 audio-x-generic "$summary" "$body" '[]' '{}' 5000 >/dev/null 2>&1
  fi
fi
exit "$rc"
