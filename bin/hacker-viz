#!/bin/bash
# Play a track in a "hacker terminal" audio visualizer, looping forever.
# Colors come from the current Omarchy theme (colors.toml) and follow theme
# changes live with a smooth color fade (the Omarchy plugin calls
# `hacker-viz retheme` when the theme changes). HACKER_VIZ_THEME=green gives the
# original matrix-green look.
# Usage: hacker-viz [URL | file | "search terms"] [label]
# Default: Petite Meller - High Forever (Marlon Hoffstadt Remix)
# Keys (mpv): f fullscreen, space pause, q quit.
# Running it again while it's open closes it.
#   hacker-viz status   -> prints on/off
#   hacker-viz retheme  -> fade running visualizers to the current theme's colors

TITLE="h4x0r viz ::"
RUNBASE="${XDG_RUNTIME_DIR:-/tmp}"
running() { pgrep -f -- "--title=$TITLE" >/dev/null; }
case "$1" in
  status) running && echo on || { echo off; exit 1; }; exit ;;
  off) pkill -f -- "--title=$TITLE"; exit 0 ;;
  retheme)
    for d in "$RUNBASE"/hacker-viz.*/; do
      pid=${d%/}; pid=${pid##*.}
      [[ $pid =~ ^[0-9]+$ ]] || continue
      # only signal a live hacker-viz (a stale dir's PID may belong to something else now)
      if tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'hacker-viz'; then
        kill -USR1 "$pid"
      else
        rm -rf "${d%/}"
      fi
    done
    exit 0 ;;
esac
if [[ -z $1 ]] && running; then pkill -f -- "--title=$TITLE"; exit 0; fi

# Launched from the Omarchy shell (or a keybind) stdout is a pipe nobody may read;
# mpv's constant status output would fill it and freeze playback. Keep output only
# for interactive terminal use.
[[ -t 1 ]] || exec >/dev/null 2>&1 </dev/null

SRC="${1:-https://www.youtube.com/watch?v=T6hOlik58gg}"
LABEL="${2:-Petite Meller — High Forever (Marlon Hoffstadt Remix)}"
[[ $SRC == http* || -e $SRC ]] || SRC="ytdl://ytsearch1:$SRC"

# --- audio cache: resolving a YouTube URL costs 2+ s on every launch (more when
# YouTube rotates its player JS), so the first play streams while a background
# yt-dlp saves the audio; later plays of the same URL/search start instantly.
# Clear with: rm -rf ~/.cache/hacker-viz
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hacker-viz"
if [[ ! -e $SRC ]]; then
  key=$(printf '%s' "$SRC" | sha1sum | cut -c1-16)
  cached=$(find "$CACHE" -maxdepth 1 -name "$key.*" ! -name '*.part' ! -name '*.ytdl' -size +0 2>/dev/null | head -1)
  if [[ -n $cached ]]; then
    SRC=$cached
  elif ! pgrep -f -- "hacker-viz-cache/$key" >/dev/null; then
    mkdir -p "$CACHE"
    setsid -f yt-dlp -q --no-warnings --no-playlist -f bestaudio/best \
      -o "$CACHE/$key.%(ext)s" --exec "true hacker-viz-cache/$key" "${SRC#ytdl://}" >/dev/null 2>&1
  fi
fi

RUN="$RUNBASE/hacker-viz.$$"
mkdir -p "$RUN"
trap 'kill $HEXPID $MPVPID 2>/dev/null; rm -rf "$RUN"' EXIT
# make TERM/INT/HUP (e.g. the Omarchy shell stopping the plugin) run the EXIT cleanup too
trap 'exit 143' TERM INT HUP

FONT="JetBrainsMono Nerd Font"

# --- colors -------------------------------------------------------------------
# The graph below draws a color-neutral *mask*: red channel = accent layers
# (prompt, clock, spectrogram, bars, waveform, borders, grid), green = foreground
# layers (status lines, hex dump, footer), blue = alert (SIGNAL LOCKED), black =
# background. One colorchannelmixer (@theme, in mpv's --vf chain) maps the mask
# onto the theme:  out = BG + R*(ACCENT-BG) + G*(FG-BG) + B*(ALERT-BG).
# A theme change only sends new coefficients to that filter, stepped over
# ~0.8 s, so colors fade smoothly and playback/audio are never touched.

theme_colors() { # -> 12 ints: bg, accent, fg, alert (r g b each)
  local f="$HOME/.local/state/omarchy/current/theme/colors.toml"
  [[ ${HACKER_VIZ_THEME:-} == green ]] && f=/dev/null
  local key fb v out=()
  for key in background:020702 accent:00ff41 foreground:00ff41 red:ff2bd6; do
    fb=${key#*:}; key=${key%%:*}
    v=$(sed -n "s/^$key[[:space:]]*=[[:space:]]*\"#\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$f" 2>/dev/null | head -1)
    v=${v:-$fb}
    out+=($((16#${v:0:2})) $((16#${v:2:2})) $((16#${v:4:2})))
  done
  echo "${out[*]}"
}

# colorchannelmixer options for 12 color values (bg, accent, fg, alert)
mixer() {
  awk -v c="$*" 'BEGIN {
    split(c, v, " "); split("r g b", ch, " ")
    for (i = 1; i <= 3; i++) {
      bg = v[i]; k[ch[i] "r"] = (v[3+i]-bg)/255; k[ch[i] "g"] = (v[6+i]-bg)/255
      k[ch[i] "b"] = (v[9+i]-bg)/255; k[ch[i] "a"] = bg/255
    }
    n = split("rr rg rb ra gr gg gb ga br bg bb ba", names, " ")
    for (j = 1; j <= n; j++) s = s (j > 1 ? ":" : "") names[j] "=" sprintf("%.5f", k[names[j]])
    print s
  }'
}

CUR=($(theme_colors))
bghex() { printf '#%02x%02x%02x' "$1" "$2" "$3"; }

# fade the running mpv from CUR to the theme's current colors (~0.8 s, smoothstep)
retheme() {
  local NEW=($(theme_colors))
  [[ ${NEW[*]} == "${CUR[*]}" ]] && return
  awk -v from="${CUR[*]}" -v to="${NEW[*]}" -v steps=24 'BEGIN {
    split(from, a, " "); split(to, b, " "); split("r g b", ch, " ")
    n = split("rr rg rb ra gr gg gb ga br bg bb ba", names, " ")
    for (s = 1; s <= steps; s++) {
      x = s / steps; e = x * x * (3 - 2 * x)
      for (j = 1; j <= 12; j++) v[j] = a[j] + (b[j] - a[j]) * e
      for (i = 1; i <= 3; i++) {
        bg = v[i]; k[ch[i] "r"] = (v[3+i]-bg)/255; k[ch[i] "g"] = (v[6+i]-bg)/255
        k[ch[i] "b"] = (v[9+i]-bg)/255; k[ch[i] "a"] = bg/255
      }
      for (j = 1; j <= n; j++)
        printf "{\"command\":[\"vf-command\",\"theme\",\"%s\",\"%.5f\"]}\n", names[j], k[names[j]]
      printf "{\"command\":[\"set_property\",\"background-color\",\"#%02x%02x%02x\"]}\n", v[1], v[2], v[3]
      fflush(); system("sleep 0.033")
    }
  }' | socat - "UNIX-CONNECT:$RUN/mpv.sock" >/dev/null 2>&1
  CUR=("${NEW[@]}")
}

# --- mask graph (colors are applied afterwards by @theme) ----------------------
# Every layer is generated from the audio, with no free-running sources: the
# frequency-bar stream, padded to full size, *is* the canvas. With --loop-file each
# loop seeks the audio back to 0. A free-running source (e.g. `color`) would keep
# counting up, and the overlays would buffer its frames without bound (~360 MB/s).
A=0xff0000 F=0x00ff00 L=0x0000ff
GRAPH="[aid1]asplit=4[ao][a1][a2][a3];
[a1]showspectrum=s=1380x420:slide=scroll:mode=combined:color=green:scale=log:fscale=log:legend=0:gain=1.6:fps=30,format=rgba,colorchannelmixer=rr=0:rg=1:gr=0:gg=0:br=0:bg=0:bb=0[spec];
[a2]aformat=channel_layouts=mono,showfreqs=s=1920x290:rate=30:mode=bar:ascale=log:fscale=log:colors=${A}:win_size=2048:averaging=3,format=rgb24,pad=1920:1080:0:590:color=black,format=rgba[base];
[a3]aformat=channel_layouts=mono,showwaves=s=1920x170:mode=cline:colors=${A}:draw=full:rate=30,format=rgba[wave];
[base][spec]overlay=20:150[t1];
[t1][wave]overlay=0:895,
drawbox=x=18:y=148:w=1384:h=424:color=${A}@0.5:t=2,
drawbox=x=1418:y=148:w=484:h=424:color=${A}@0.5:t=2,
drawgrid=w=60:h=30:t=1:c=${A}@0.05,
drawtext=font='${FONT}':textfile='$RUN/prompt.txt':expansion=none:x=22:y=14:fontsize=21:fontcolor=${A},
drawtext=font='${FONT}':textfile='$RUN/header.txt':expansion=none:x=22:y=44:fontsize=21:line_spacing=6:fontcolor=${F},
drawtext=font='${FONT}':textfile='$RUN/hex.txt':reload=1:expansion=none:x=1428:y=162:fontsize=14:line_spacing=7:fontcolor=${F}@0.75,
drawtext=font='${FONT}':text='T+%{pts\:hms}':x=w-tw-24:y=14:fontsize=26:fontcolor=${A},
drawtext=font='${FONT}':text='[ SIGNAL LOCKED ]':x=w-tw-24:y=52:fontsize=20:fontcolor=${L}:enable='lt(mod(t\,1)\,0.6)',
drawtext=font='${FONT}':text='RCE R1TU4L ST4RT3D -> 0P3N1NG P0RT4L':x=22:y=1072-th:fontsize=18:fontcolor=${F}@0.6[vo]"

printf '%s\n' "root@$(hostname):~# ./php2shell --profile 21 --stream audio://$(echo "$LABEL" | tr ' ' '_' | tr -cd '[:alnum:]_().-' | cut -c1-48)" >"$RUN/prompt.txt"
printf '%s\n' \
  "[*] START  operation initialized" \
  "[>] INFO   payload :: $LABEL" \
  "[#] STAGE  CHAIN ACTIVE :: spectral exfiltration :: loop=inf" >"$RUN/header.txt"

# live-updating hex dump column (first page written up front so mpv can start at once)
addr=$((0x7ffd3a2c0000))
hexpage() {
  for _ in $(seq 1 18); do
    printf '0x%012x  ' "$addr"
    head -c 8 /dev/urandom | od -An -tx1 | tr -s ' ' | sed 's/^ //' | tr '\n' ' '
    printf ' |%-8s|\n' "$(head -c 32 /dev/urandom | tr -dc 'A-Za-z0-9#$&*+<>?.' | head -c 8)"
    addr=$((addr + 8))
  done >"$RUN/hex.tmp" && mv -f "$RUN/hex.tmp" "$RUN/hex.txt"
}
hexpage
( while :; do sleep 0.12; hexpage; done ) &
HEXPID=$!

trap retheme USR1
# Safety net: run mpv in its own memory-capped scope (normal use is ~400 MB), so a
# runaway filter graph can only kill the visualizer, never the whole desktop.
MEMCAP=()
systemd-run --user --scope -q true >/dev/null 2>&1 &&
  MEMCAP=(systemd-run --user --scope -q -p MemoryMax=1500M -p MemorySwapMax=0 --)
"${MEMCAP[@]}" mpv --msg-level=all=info --loop-file=inf --ytdl-format=bestaudio/best --force-window=immediate \
  --title="$TITLE $LABEL" --keep-open=no --osc=no \
  --background=color --background-color="$(bghex "${CUR[@]:0:3}")" \
  --gpu-api=opengl --no-resume-playback --save-position-on-quit=no --autocreate-playlist=no \
  --input-ipc-server="$RUN/mpv.sock" \
  --lavfi-complex="$GRAPH" --vf="@theme:colorchannelmixer=$(mixer "${CUR[@]}")" "$SRC" &
MPVPID=$!

# mpv runs in the background so a theme change (SIGUSR1) can be handled
# while it plays; `wait` returns early on the signal, so loop until mpv exits.
while kill -0 "$MPVPID" 2>/dev/null; do wait "$MPVPID"; done
